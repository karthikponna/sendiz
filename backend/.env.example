# Required
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Neon Console > Auth > Configuration > Auth Base URL
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.c-x.us-east-2.aws.neon.tech/neondb/auth

# Everything below is optional; these are the defaults.
PORT=8080
REDIS_URL=redis://localhost:6379
DB_MAX_OPEN_CONN=20

# Worker
WORKER_COUNT=10
MAX_ATTEMPTS=3
RETRY_AFTER=30s

# SMTP (defaults point at Mailpit running locally)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT=15s
